# Database (SQLite is the sole v1 backend; pure-Go driver, no external server needed)
# A relative host creates ./alice-companion.db; use sqlite:///abs/path.db for an absolute path
DATABASE__URL=sqlite://alice-companion.db

# Goose CLI (optional; only needed to run migrations by hand)
# Driver must match the modernc.org/sqlite registration ("sqlite"), not "sqlite3"
GOOSE_DRIVER=sqlite
GOOSE_DBSTRING=alice-companion.db
GOOSE_MIGRATION_DIR=internal/db/migrations

# Actions
AWS_REGION=
AWS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_ENDPOINT=

# Alice Dialogs webhook (POST /api/v1/alice/webhook)
# Shared secret required in the X-Alice-Secret header; empty rejects every request
ALICE__SHARED_SECRET=

# HTTP client (app-wide default)
HTTP_CLIENT__PROXY_URL=
HTTP_CLIENT__BYPASS=
# duration; 0s = no client timeout
HTTP_CLIENT__TIMEOUT=0s
HTTP_CLIENT__MAX_IDLE_CONNS=
HTTP_CLIENT__MAX_IDLE_CONNS_PER_HOST=
# duration; 0s = inherit the default transport
HTTP_CLIENT__IDLE_CONN_TIMEOUT=0s
HTTP_CLIENT__TLS__ROOT_CA_FILE=
HTTP_CLIENT__TLS__ROOT_CA_PEM=
HTTP_CLIENT__TLS__ROOT_CA_REPLACE_SYSTEM=

# Cache
# memory:// (default) or redis://... ; redis:// needs Redis 7.4 or later (HEXPIREAT),
# use a shared Redis for multiple replicas
CACHE__URL=memory://
# duration; must be positive, the app fails at startup if the sweeper is enabled and this is not
CACHE__SWEEP_INTERVAL=1m
